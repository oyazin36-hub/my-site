[
  {"start": "00:00.0", "end": "00:01.8", "text": "[instrumental]"},
  {"start": "00:01.8", "end": "00:04.6", "text": "1948年"},
  {"start": "00:04.6", "end": "00:07.4", "text": "ここから始まった"},
  {"start": "00:07.4", "end": "00:10.5", "text": "受け継いだ技術"},
  {"start": "00:10.5", "end": "00:14.3", "text": "積み重ねた想い"},
  {"start": "00:14.3", "end": "00:20.9", "text": "時代が変わっても変わらないものがある"},
  {"start": "00:20.9", "end": "00:27.4", "text": "モノづくりの情熱"},
  {"start": "00:27.4", "end": "00:32.4", "text": "[instrumental]"},
  {"start": "00:32.4", "end": "00:36.0", "text": "鉄を削り形を生み出す"},
  {"start": "00:36.0", "end": "00:39.4", "text": "大きな素材に挑み続ける"},
  {"start": "00:39.4", "end": "00:44.8", "text": "1ミリ 1ミクロン"},
  {"start": "00:44.8", "end": "00:47.7", "text": "その先にある精度を追い"},
  {"start": "00:47.7", "end": "00:52.4", "text": "見えないところまで妥協せず向き合う"},
  {"start": "00:52.4", "end": "00:55.8", "text": "技術は人から人へ"},
  {"start": "00:55.8", "end": "01:00.0", "text": "想いは未来へ"},
  {"start": "01:00.0", "end": "01:03.0", "text": "守るべき技術を守り抜く"},
  {"start": "01:03.0", "end": "01:06.4", "text": "変えるべきものは変えていく"},
  {"start": "01:06.4", "end": "01:09.6", "text": "昨日を超えて今日を超えて"},
  {"start": "01:09.6", "end": "01:13.6", "text": "まだ見ぬ未来へ"},
  {"start": "01:13.6", "end": "01:20.3", "text": "技術力 設計力 設備力 人間力"},
  {"start": "01:20.3", "end": "01:26.3", "text": "すべての力を一つにして"},
  {"start": "01:26.3", "end": "01:30.0", "text": "まだない価値を作り出せ"},
  {"start": "01:30.0", "end": "01:32.9", "text": "この手で この技術で"},
  {"start": "01:32.9", "end": "01:36.4", "text": "未来を切り拓け"},
  {"start": "01:36.4", "end": "01:40.4", "text": "原マシナリー"},
  {"start": "01:40.4", "end": "01:43.7", "text": "難しい素材も不可能じゃない"},
  {"start": "01:43.7", "end": "01:47.3", "text": "シリコン サファイア ガラス 石英"},
  {"start": "01:47.3", "end": "01:50.8", "text": "削る 磨く 組み上げる"},
  {"start": "01:50.8", "end": "01:54.0", "text": "一つひとつに技術が宿る"},
  {"start": "01:54.0", "end": "01:59.8", "text": "設計から加工まで一貫して応えていく"},
  {"start": "01:59.8", "end": "02:06.7", "text": "求められるもののその先へ"},
  {"start": "02:06.7", "end": "02:13.7", "text": "品質を追い コストに挑み 納期を守る"},
  {"start": "02:13.7", "end": "02:21.4", "text": "信頼は一つひとつの仕事から積み上げていく"},
  {"start": "02:21.4", "end": "02:28.7", "text": "技術力 設計力 設備力 人間力"},
  {"start": "02:28.7", "end": "02:34.5", "text": "受け継いだ力を進化させ"},
  {"start": "02:34.5", "end": "02:38.2", "text": "次の時代を作り出せ"},
  {"start": "02:38.2", "end": "02:41.2", "text": "このまちから世界へ"},
  {"start": "02:41.2", "end": "02:44.4", "text": "未来を動かせ"},
  {"start": "02:44.4", "end": "02:48.8", "text": "原マシナリー"},
  {"start": "02:48.8", "end": "02:52.5", "text": "変化を恐れない"},
  {"start": "02:52.5", "end": "02:55.7", "text": "挑戦を止めない"},
  {"start": "02:55.7", "end": "02:58.8", "text": "人がいる 技術がある"},
  {"start": "02:58.8", "end": "03:03.9", "text": "仲間がいる だからできる"},
  {"start": "03:03.9", "end": "03:09.9", "text": "一つの会社から 一つの技術から"},
  {"start": "03:09.9", "end": "03:15.9", "text": "世界の未来へ"},
  {"start": "03:15.9", "end": "03:29.8", "text": "[instrumental]"},
  {"start": "03:29.8", "end": "03:36.9", "text": "技術力 設計力 設備力 人間力"},
  {"start": "03:36.9", "end": "03:42.8", "text": "4つの力を一つにして"},
  {"start": "03:42.8", "end": "03:46.7", "text": "新しい時代を切り拓け"},
  {"start": "03:46.7", "end": "03:53.3", "text": "1948年から受け継いだモノづくり"},
  {"start": "03:53.3", "end": "03:56.8", "text": "100年企業へ その先へ"},
  {"start": "03:56.8", "end": "04:01.3", "text": "まだ見ぬ未来をこの手で作る"},
  {"start": "04:01.3", "end": "04:07.4", "text": "技術で未来を切り拓け 原マシナリー"},
  {"start": "04:07.4", "end": "04:10.7", "text": "受け継ぐ技術"},
  {"start": "04:10.7", "end": "04:13.9", "text": "挑み続ける心"},
  {"start": "04:13.9", "end": "04:18.9", "text": "モノづくりの未来へ"},
  {"start": "04:18.9", "end": "04:24.4", "text": "原マシナリー"},
  {"start": "04:24.4", "end": "04:36.0", "text": "[instrumental]"}
]
